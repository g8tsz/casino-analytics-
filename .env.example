# Data source: mock | api | database
# - mock: built-in demo data (default)
# - api: fetch from your existing backend (set LIVE_API_BASE_URL)
# - database: read from PostgreSQL (set DATABASE_URL)
DATA_SOURCE=mock

# For DATA_SOURCE=api: base URL of your casino/CMS API (must expose same JSON as /api/analytics, /api/alerts, etc.)
# LIVE_API_BASE_URL=https://your-cms.example.com

# Optional API key when calling external live API
# LIVE_API_KEY=your-secret-key

# For DATA_SOURCE=database: PostgreSQL connection string
# DATABASE_URL=postgresql://user:password@host:5432/casino_analytics
